# PlatformIO build output
.pio/
.vscode/

# macOS metadata
.DS_Store
._*

# VS Code workspace file
*.code-workspace

# Generated blocklist (build it with tools/build_blocklist.py)
data/blocklist.bin

# WiFi credentials (copy src/secrets.example.h -> src/secrets.h)
src/secrets.h

# Backups / scratch
*.bak

# AI agent session state. These appear in the working tree while an agent runs and are not
# part of the project; one of them (a plugin_root pointer) holds an absolute local path.
.mimosa/
.v2c/

# Python bytecode
__pycache__/
*.pyc
src/page_gz.h
